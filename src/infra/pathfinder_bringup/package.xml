<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pathfinder_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for PathFinder.</description>
  <maintainer email="levon.alexanian10@gmail.com">Levon Alexanian</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>pathfinder_core</exec_depend>
  <exec_depend>pathfinder_algo_astar</exec_depend>
  <exec_depend>pathfinder_algo_dijkstra</exec_depend>
  <exec_depend>pathfinder_algo_dstar_lite</exec_depend>
  <exec_depend>pathfinder_algo_rrt</exec_depend>
  <exec_depend>pathfinder_rerun</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
